# Copia este archivo como .dev.vars (sin .example) y pega tu cadena de conexión de Neon.
# .dev.vars está excluido de git: nunca se sube a GitHub.
# En Neon: Dashboard > Connect > desmarca "Connection pooling" y copia la cadena completa.
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST.neon.tech/neondb?sslmode=require
# Segundos que espera la compilación agrupada del sitio (en producción, 300).
BUILD_BATCH_SECONDS=6
